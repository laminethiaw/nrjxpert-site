<tr><td>≤ 1 kV (tolérance +6 %)</td><td class="num">1,05</td><td class="num">0,95</td></tr>
<tr><td>≤ 1 kV (tolérance +10 %)</td><td class="num">1,10</td><td class="num">0,95</td></tr>
