  /* la hauteur du cadre suit celle de l'image affichée (les captures n'ont pas toutes les mêmes proportions) */
  function fit(){
    var im=slides.children[cur] && slides.children[cur].firstChild;
    if(im && im.offsetHeight>0) viewport.style.height=im.offsetHeight+"px";
  }
  window.addEventListener("resize", fit);
  function render(){
