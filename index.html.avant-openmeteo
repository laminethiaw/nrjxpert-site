<style>
:root{
  --primary:#0f4c81; --primary-2:#1a6bb5; --gold:#e8a020; --gold-soft:#fdf3e0;
  --bg:#f5f6f8; --panel:#ffffff; --ink:#1a1f2e; --muted:#5a6275; --line:#dde1ea;
  --c1:#1d5fa8; --c2:#2f7d4f; --c3:#0f766e; --c4:#b42318;
  --shadow:0 1px 2px rgba(16,24,40,.05), 0 6px 20px rgba(16,24,40,.06);
  --radius:14px; --maxw:1160px;
}
@media (prefers-color-scheme: dark){
  :root{ --bg:#0e1420; --panel:#151d2b; --ink:#e7ebf3; --muted:#9aa4b8; --line:#26324a; --gold-soft:#2a2214;
         --c1:#7fb2f0; --c2:#7bd3a0; --c3:#5eead4; --c4:#f59a8f; --shadow:0 1px 2px rgba(0,0,0,.3), 0 8px 24px rgba(0,0,0,.25); }
}
*{ box-sizing:border-box; }
html{ scroll-behavior:smooth; scroll-padding-top:76px; }
body{ margin:0; background:var(--bg); color:var(--ink); font:16px/1.65 'IBM Plex Sans', -apple-system, "Segoe UI", Roboto, Arial, sans-serif; }
a{ color:inherit; }
.wrap{ max-width:var(--maxw); margin:0 auto; padding:0 24px; }

/* bilingue : on masque la langue inactive */
html[lang="fr"] [lang="en"]:not(html), html[lang="en"] [lang="fr"]:not(html){ display:none !important; }

/* ── barre de menu ── */
header.top{ position:sticky; top:0; z-index:50; background:var(--primary); color:#fff; box-shadow:0 2px 12px rgba(15,76,129,.25); }
.top .wrap{ display:flex; align-items:center; gap:18px; height:64px; }
.brand{ display:flex; align-items:center; gap:10px; text-decoration:none; color:#fff; flex-shrink:0; }
.mark{ width:42px; height:42px; display:block; filter:drop-shadow(0 2px 6px rgba(0,0,0,.3)); }
.mark img{ width:100%; height:100%; display:block; }
.brand b{ font-size:1.2rem; font-weight:700; letter-spacing:.01em; }
.brand b span{ color:var(--gold); }
nav.menu{ display:flex; gap:4px; margin-left:auto; }
nav.menu a{ text-decoration:none; color:rgba(255,255,255,.82); font-size:.93rem; font-weight:500; padding:8px 13px; border-radius:8px;
  border-bottom:2px solid transparent; transition:background .15s, color .15s; white-space:nowrap; }
nav.menu a:hover, nav.menu a:focus-visible{ background:rgba(255,255,255,.12); color:#fff; outline:none; }
.lang{ display:flex; border:1px solid rgba(255,255,255,.35); border-radius:8px; overflow:hidden; flex-shrink:0; }
.lang button{ font:600 .78rem 'IBM Plex Mono', Menlo, monospace; background:none; color:rgba(255,255,255,.75); border:0; padding:6px 10px; cursor:pointer; }
.lang button[aria-pressed="true"]{ background:var(--gold); color:#1a1f2e; }
.burger{ display:none; margin-left:auto; background:none; border:1px solid rgba(255,255,255,.35); color:#fff; border-radius:8px; width:40px; height:36px; cursor:pointer; font-size:1.1rem; }

/* ── bandeau ── */
.hero{ background:linear-gradient(135deg, var(--primary) 0%, var(--primary-2) 100%); color:#fff; overflow:hidden; position:relative; }
.hero::after{ content:""; position:absolute; inset:0; pointer-events:none;
  background-image:linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
  background-size:28px 28px; mask-image:linear-gradient(90deg, transparent, #000 60%); -webkit-mask-image:linear-gradient(90deg, transparent, #000 60%); }
.hero .wrap{ display:grid; grid-template-columns:1.1fr 1fr; gap:40px; align-items:center; padding-top:64px; padding-bottom:72px; position:relative; z-index:1; }
.kicker{ font:500 .78rem 'IBM Plex Mono', Menlo, monospace; letter-spacing:.08em; text-transform:uppercase; color:var(--gold); }
.hero h1{ font-size:clamp(2rem, 4.2vw, 3.1rem); line-height:1.12; letter-spacing:-.02em; margin:12px 0 16px; font-weight:700; }
.hero p.lead{ font-size:1.08rem; color:rgba(255,255,255,.82); max-width:56ch; margin:0 0 26px; }
.cta{ display:flex; flex-wrap:wrap; gap:12px; }
.btn{ display:inline-flex; align-items:center; gap:8px; text-decoration:none; font-weight:600; font-size:.95rem; padding:11px 18px; border-radius:10px; transition:transform .15s, box-shadow .15s; }
.btn:hover{ transform:translateY(-1px); }
.btn.primary{ background:var(--gold); color:#1a1f2e; box-shadow:0 4px 14px rgba(232,160,32,.35); }
.btn.ghost{ border:1px solid rgba(255,255,255,.45); color:#fff; }
.hero svg{ width:100%; height:auto; filter:drop-shadow(0 10px 30px rgba(0,0,0,.18)); }

/* ── cartes ── */
section{ padding:64px 0; }
.head{ max-width:70ch; margin-bottom:30px; }
.head h2{ font-size:1.75rem; margin:6px 0 8px; letter-spacing:-.01em; }
.head p{ margin:0; color:var(--muted); }
.kicker.dark{ color:var(--primary-2); }
@media (prefers-color-scheme: dark){ .kicker.dark{ color:var(--gold); } }
.grid{ display:grid; grid-template-columns:repeat(4, 1fr); gap:18px; }
.card{ position:relative; display:flex; flex-direction:column; background:var(--panel); border:1px solid var(--line); border-radius:var(--radius);
  padding:22px 22px 20px; text-decoration:none; box-shadow:var(--shadow); transition:transform .18s, border-color .18s, box-shadow .18s; overflow:hidden; }
.card::before{ content:""; position:absolute; left:0; right:0; top:0; height:4px; background:var(--accent); }
.card:hover{ transform:translateY(-3px); border-color:var(--accent); box-shadow:0 12px 32px rgba(16,24,40,.12); }
.card .ico{ width:46px; height:46px; border-radius:12px; display:grid; place-items:center; background:color-mix(in srgb, var(--accent) 12%, transparent); color:var(--accent); margin-bottom:14px; }
.card .tag{ font:500 .72rem 'IBM Plex Mono', Menlo, monospace; color:var(--accent); letter-spacing:.04em; text-transform:uppercase; }
.card h3{ margin:4px 0 8px; font-size:1.18rem; line-height:1.3; }
.card p{ margin:0 0 14px; color:var(--muted); font-size:.93rem; }
.card ul{ margin:0 0 16px; padding-left:18px; color:var(--muted); font-size:.88rem; }
.card ul li{ margin:2px 0; }
.card .go{ margin-top:auto; font-weight:600; font-size:.92rem; color:var(--accent); display:flex; align-items:center; gap:6px; }
.card:hover .go span.arrow{ transform:translateX(4px); }
.go span.arrow{ transition:transform .18s; }
.c1{ --accent:var(--c1); } .c2{ --accent:var(--c2); } .c3{ --accent:var(--c3); } .c4{ --accent:var(--c4); }

/* ── points forts ── */
.band{ background:var(--panel); border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
.feats{ display:grid; grid-template-columns:repeat(3, 1fr); gap:28px; }
.feat h4{ margin:0 0 6px; font-size:1.02rem; display:flex; align-items:center; gap:8px; }
.feat h4 i{ font-style:normal; width:28px; height:28px; border-radius:8px; display:grid; place-items:center; background:var(--gold-soft); font-size:.95rem; }
.feat p{ margin:0; color:var(--muted); font-size:.93rem; }

/* ── à propos / pied ── */
.about{ display:grid; grid-template-columns:1fr 1fr; gap:36px; align-items:start; }
.about p{ color:var(--muted); margin:0 0 12px; }
.about .box{ background:var(--panel); border:1px solid var(--line); border-left:4px solid var(--gold); border-radius:10px; padding:18px 22px; }
.about .box b{ color:var(--ink); }
footer{ background:#0b2d4f; color:rgba(255,255,255,.7); font-size:.88rem; padding:28px 0; }
footer .wrap{ display:flex; flex-wrap:wrap; gap:14px 28px; justify-content:space-between; align-items:center; }
footer nav{ display:flex; flex-wrap:wrap; gap:6px 20px; }
footer a{ color:rgba(255,255,255,.85); text-decoration:none; }
footer a:hover{ color:var(--gold); }

/* ── galerie / carrousel ── */
#apercu .carousel{ position:relative; max-width:860px; margin:0 auto; }
.viewport{ position:relative; overflow:hidden; transition:height .35s ease; border-radius:16px; border:1px solid var(--line); box-shadow:var(--shadow); background:var(--panel); }
.slides{ display:flex; align-items:flex-start; }
.slides.anim{ transition:transform .55s cubic-bezier(.4,0,.2,1); }
.slide{ min-width:100%; margin:0; }
.slide img{ width:100%; display:block; object-fit:contain; }
.slide img.tall{ max-height:480px; }   /* capture en portrait (fenêtre étroite) : taille réduite, centrée */
.cbtn{ position:absolute; top:50%; transform:translateY(-50%); z-index:2; width:42px; height:42px; border-radius:50%;
  border:1px solid var(--line); background:rgba(255,255,255,.9); color:var(--ink); font-size:1.5rem; line-height:1; cursor:pointer;
  display:grid; place-items:center; box-shadow:0 2px 10px rgba(16,24,40,.15); transition:background .15s; }
.cbtn:hover{ background:#fff; }
.cbtn.prev{ left:12px; } .cbtn.next{ right:12px; }
@media (prefers-color-scheme: dark){ .cbtn{ background:rgba(21,29,43,.85); color:var(--ink); } .cbtn:hover{ background:var(--panel); } }
.shot-caption{ text-align:center; color:var(--muted); font-size:.92rem; margin:14px 0 0; min-height:1.2em; }
.dots{ display:flex; gap:8px; justify-content:center; margin-top:14px; }
.dot{ width:9px; height:9px; border-radius:50%; background:var(--line); border:none; padding:0; cursor:pointer; transition:all .2s; }
.dot.on{ background:var(--primary-2); width:24px; border-radius:5px; }
@media (max-width:560px){ .cbtn{ width:34px; height:34px; font-size:1.2rem; } }

/* ── adaptations ── */
@media (max-width:1020px){
  .grid{ grid-template-columns:repeat(2, 1fr); }
  nav.menu a{ padding:8px 9px; font-size:.88rem; }
}
@media (max-width:860px){
  .burger{ display:block; }
  .top .wrap{ gap:12px; }
  nav.menu{ position:absolute; top:64px; left:0; right:0; flex-direction:column; gap:0; background:var(--primary); padding:6px 16px 14px;
    box-shadow:0 10px 20px rgba(0,0,0,.2); display:none; }
  nav.menu.open{ display:flex; }
  nav.menu a{ padding:12px 10px; font-size:1rem; border-bottom:1px solid rgba(255,255,255,.1); border-radius:0; }
  .lang{ margin-left:0; }
  .hero .wrap{ grid-template-columns:1fr; padding-top:44px; padding-bottom:48px; }
  .feats, .about{ grid-template-columns:1fr; }
}
@media (max-width:560px){
  .wrap{ padding:0 16px; }
  .grid{ grid-template-columns:1fr; }
  .brand b{ font-size:1.05rem; }
  section{ padding:44px 0; }
}
@media (prefers-reduced-motion: reduce){ *{ transition:none !important; scroll-behavior:auto !important; } }

.offers{ grid-template-columns:repeat(3, 1fr); }
.offers .card{ cursor:default; }
.offers .card:hover{ transform:none; box-shadow:none; }
.offers .note{ margin:22px 0 0; color:var(--muted); font-size:.9rem; }
.offers-cta{ margin-top:18px; }
.offers-cta .btn.primary{ color:#1a1f2e; }
@media (max-width:980px){ .offers{ grid-template-columns:1fr; } }
</style>
